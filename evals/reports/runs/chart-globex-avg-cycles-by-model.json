  "queries": [
    {
      "handle": "Q1",
      "sql": "SELECT model_name, ROUND(CAST(AVG(battery_cycle_count) AS DECIMAL), 1) AS avg_battery_cycles, COUNT(*) AS device_count FROM telemetry.v_latest_device_state WHERE battery_present = TRUE GROUP BY model_name ORDER BY avg_battery_cycles DESC LIMIT 200",
