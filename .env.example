# =============================================================================
# Step M1: Local PostgreSQL (Docker Compose) & Role Connections
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fleet_copilot
POSTGRES_PORT=5432

ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleet_copilot
TELEMETRY_WRITER_DATABASE_URL=postgresql://telemetry_writer:telemetry_writer@localhost:5432/fleet_copilot
TELEMETRY_RO_DATABASE_URL=postgresql://telemetry_ro:telemetry_ro@localhost:5432/fleet_copilot
COPILOT_DATABASE_URL=postgresql://copilot_app:copilot_app@localhost:5432/fleet_copilot
DEMO_OPS_DATABASE_URL=postgresql://demo_ops:demo_ops@localhost:5432/fleet_copilot

TELEMETRY_WRITER_PASSWORD=telemetry_writer
TELEMETRY_RO_PASSWORD=telemetry_ro
COPILOT_APP_PASSWORD=copilot_app
DEMO_OPS_PASSWORD=demo_ops

# =============================================================================
# Step 0: Testing & Provisional LLM Model
# =============================================================================
TEST_DB_NAME=fleet_copilot_test
# Set REQUIRE_DB=1 (used in CI) to fail instead of skipping when Postgres is unreachable
# REQUIRE_DB=1
LLM_MODEL=google_genai:gemini-3.8-flash

# =============================================================================
# Step 1: Data Clock Override
# =============================================================================
# Optional ISO-8601 UTC override for telemetry_as_of (empty = max(collected_at) per tenant)
FLEET_AS_OF=

# =============================================================================
# Step 4: Actions Kill-Switch & Privacy Pseudonym Key
# =============================================================================
ACTIONS_ENABLED=true
# 64 hex chars (generate with: openssl rand -hex 32)
# DEV ONLY — rotate for hosting!
PSEUDONYM_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Credentialed tenant-lock HMAC-SHA256 key: 64 hex chars (generate with: openssl rand -hex 32)
# DEV ONLY — rotate for hosting!
TENANT_LOCK_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# =============================================================================
# Step 5: Gemini API, Replay Cassettes, Checkpoint Encryption & Logging
# =============================================================================
GEMINI_API_KEY=
LLM_REPLAY_MODE=off
LLM_CASSETTE_DIR=evals/cassettes
# Checkpoint AES-256-EAX key: 32 ASCII bytes (generate with: openssl rand -hex 16)
# DEV ONLY — rotate for hosting!
LANGGRAPH_AES_KEY=0123456789abcdef0123456789abcdef
LOG_FORMAT=json
LOG_LEVEL=INFO

# =============================================================================
# Step 7: Demo API / UI Auth, Mode & Budgets
# =============================================================================
# dev allows code "dev" when DEMO_ACCESS_CODES is empty; prod refuses to start without codes
APP_ENV=dev
# Enables demo reset & scenario-injection SECURITY DEFINER functions (written to DB by migrate)
DEMO_MODE=true
# 64 hex chars (generate with: openssl rand -hex 32)
# DEV ONLY — rotate for hosting!
SESSION_SIGNING_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90
# Format: "code-abc:rev_01,code-def:rev_02" (empty in dev -> code "dev" allowed)
DEMO_ACCESS_CODES=
DEMO_ADMIN_TOKEN=
DEMO_SPEND_CAP_USD=2.00
DEMO_TURNS_PER_CODE=25
DEMO_TURNS_PER_HOUR=20
DAILY_TOKEN_BUDGET=2000000

# =============================================================================
# Step 8: Retention Jobs
# =============================================================================
TURN_RETENTION_DAYS=7
